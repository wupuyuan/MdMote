{
  "name": "mdmote",
  "version": "1.0.0",
  "description": "MdMote - Cross-platform Markdown editor with glassmorphism UI",
  "author": {
    "name": "wupuyuan",
    "email": "wupuyuan@gmail.com"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "monaco-editor": "^0.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "vite-plugin-electron": "^0.28.7"
  },
  "build": {
    "appId": "com.markdown.editor",
    "productName": "MdMote",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}